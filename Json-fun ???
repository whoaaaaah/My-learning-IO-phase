using System;
using System.IO;
using System.Text.Json;

namespace EntryPoint
    {
    class Data
    {
        dynamic _money = 0;
        public DateTimeOffset CreatedTime {get; } = DateTimeOffset.Now;
        public dynamic Money => _money;
        public void UpdateMoney(dynamic money)
        => _money = Math.Max(_money += money,0);
    }
    class Program 
    {
        public static void Main(string[] args) 
        {
            JsonSerializerOptions option = new JsonSerializerOptions{ WriteIndented = true  };
            Data data = new Data();
            while(true)
            {
                string input = Console.ReadLine();
                if(input == "add")
                {
                    data.UpdateMoney(5);
                    Console.WriteLine($"Your money : {data.Money}");
                }
                else if(string.Equals(input,"sub", StringComparison.InvariantCultureIgnoreCase))
                {
                    data.UpdateMoney(-5);
                    Console.WriteLine($"Your money : {data.Money}"); 
                }
                else if(string.Equals(input,"json", StringComparison.InvariantCultureIgnoreCase))
                {
                    Console.WriteLine($" {JsonSerializer.Serialize(data,option)}   ");
                }
                else if(string.Equals(input,"quit", StringComparison.InvariantCultureIgnoreCase))
                {
                    break;
                }
        }
        }
    }
}
